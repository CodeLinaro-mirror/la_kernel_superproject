[submodule "kernel/build"]
	branch = master-kernel-build-2021
	path = build
	url = ../build
[submodule "kernel/goldfish"]
	branch = android-goldfish-4.4-dev
	path = goldfish
	url = ../goldfish
[submodule "kernel/tests"]
	branch = pie-dev
	path = kernel/tests
	url = ../tests
[submodule "platform/prebuilts/build-tools"]
	branch = main
	shallow = true
	path = prebuilts/build-tools
	url = ../../platform/prebuilts/build-tools
[submodule "platform/prebuilts/clang/host/linux-x86"]
	path = prebuilts-master/clang/host/linux-x86
	url = ../../platform/prebuilts/clang/host/linux-x86
[submodule "platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"]
	branch = master-kernel-build-2021
	shallow = true
	path = prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9
	url = ../../platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9
[submodule "platform/prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9"]
	branch = master-kernel-build-2021
	shallow = true
	path = prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9
	url = ../../platform/prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9
