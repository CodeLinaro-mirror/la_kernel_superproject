[submodule "kernel/build"]
	branch = main
	path = build
	url = ../build
[submodule "kernel/common"]
	branch = android-mainline
	path = common
	url = ../common
[submodule "kernel/common-modules/virtual-device"]
	branch = android-mainline
	path = common-modules/virtual-device
	url = ../common-modules/virtual-device
[submodule "kernel/common-patches"]
	branch = main
	path = kernel/common-patches
	url = ../common-patches
[submodule "kernel/configs"]
	branch = main
	path = kernel/configs
	url = ../configs
[submodule "kernel/prebuilts/build-tools"]
	branch = main
	shallow = true
	path = prebuilts/kernel-build-tools
	url = ../prebuilts/build-tools
[submodule "kernel/tests"]
	branch = main
	path = kernel/tests
	url = ../tests
[submodule "platform/external/stardoc"]
	branch = main
	path = external/stardoc
	url = ../../platform/external/stardoc
[submodule "platform/prebuilts/bazel/linux-x86_64"]
	branch = main
	shallow = true
	path = prebuilts/bazel/linux-x86_64
	url = ../../platform/prebuilts/bazel/linux-x86_64
[submodule "platform/prebuilts/boot-artifacts"]
	branch = main
	path = prebuilts/boot-artifacts
	url = ../../platform/prebuilts/boot-artifacts
[submodule "platform/prebuilts/build-tools"]
	branch = main
	shallow = true
	path = prebuilts/build-tools
	url = ../../platform/prebuilts/build-tools
[submodule "platform/prebuilts/clang/host/linux-x86"]
	branch = main
	shallow = true
	path = prebuilts/clang/host/linux-x86
	url = ../../platform/prebuilts/clang/host/linux-x86
[submodule "platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8"]
	branch = main
	shallow = true
	path = prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8
	url = ../../platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8
[submodule "platform/prebuilts/jdk/jdk11"]
	branch = main
