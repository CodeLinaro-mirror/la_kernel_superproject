[submodule "kernel/build"]
	branch = master-kernel-build-2021
	path = build
	url = ../build
[submodule "kernel/common"]
	branch = android-4.19-stable
	path = common
	url = ../common
[submodule "kernel/common-modules/virtual-device"]
	branch = android-4.19-stable
	path = common-modules/virtual-device
	url = ../common-modules/virtual-device
[submodule "kernel/configs"]
	branch = master-kernel-build-2021
	path = kernel/configs
	url = ../configs
[submodule "kernel/prebuilts/build-tools"]
	branch = master-kernel-build-2021
	shallow = true
	path = prebuilts/kernel-build-tools
	url = ../prebuilts/build-tools
[submodule "kernel/tests"]
	branch = main
	path = kernel/tests
	url = ../tests
[submodule "platform/prebuilts/asuite"]
	branch = main
	shallow = true
	path = prebuilts/asuite
	url = ../../platform/prebuilts/asuite
[submodule "platform/prebuilts/build-tools"]
	branch = master-kernel-build-2021
	shallow = true
	path = prebuilts/build-tools
	url = ../../platform/prebuilts/build-tools
[submodule "platform/prebuilts/clang/host/linux-x86"]
	branch = master-kernel-build-2021
	shallow = true
	path = prebuilts-master/clang/host/linux-x86
	url = ../../platform/prebuilts/clang/host/linux-x86
[submodule "platform/prebuilts/gas/linux-x86"]
	branch = master-kernel-build-2021
	shallow = true
	path = prebuilts/gas/linux-x86
	url = ../../platform/prebuilts/gas/linux-x86
[submodule "platform/tools/tradefederation/prebuilts"]
	branch = main
	shallow = true
	path = prebuilts/tradefed
	url = ../../platform/tools/tradefederation/prebuilts
